{
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "scripts": {
    "start:server": "npm run start:dev --prefix server",
    "start:client": "npm run dev --prefix client",
    "dev": "concurrently -n \"NEST,NEXT\" -c \"red,blue\" --prefix \"[{name}]\" --kill-others-on-fail \"npm run start:server\" \"npm run start:client\""
  }
}
