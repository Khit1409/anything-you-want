{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@/style/*": ["./styles/*"],
      "@/features/*": ["./features/*"],
      //parent folder
      "@/auth/*": ["./features/auth/*"],
      "@/user/*": ["./features/user/*"],
      "@/seller/*": ["./features/seller/*"],
      "@/product/*": ["./features/product/*"],
      "@/customer/*": ["./features/customer/*"],
      "@/cart/*": ["./features/cart/*"],
      "@/common/*": ["./features/common/*"],
      "@/store/*": ["./features/store/*"],
      //auth
      "@/authComponents/*": ["./features/auth/components/*"],
      "@/authContexts/*": ["./features/auth/contexts/*"],
      "@/authHooks/*": ["./features/auth/hooks/*"],
      "@/authServices/*": ["./features/auth/services/*"],
      "@/authPages/*": ["./features/auth/pages/*"],
      "@/authRedux/*": ["./features/auth/redux/*"],
      "@/authInterfaces/*": ["./features/auth/interfaces/*"],
      "@/authHelpers/*": ["./features/auth/helpers/*"],
      "@/authForms/*": ["./features/auth/components/forms/*"],
      //user
      "@/userComponents/*": ["./features/user/components/*"],
      "@/userContexts/*": ["./features/user/contexts/*"],
      "@/userHooks/*": ["./features/user/hooks/*"],
      "@/userServices/*": ["./features/user/services/*"],
      "@/userPages/*": ["./features/user/pages/*"],
      "@/userRedux/*": ["./features/user/redux/*"],
      "@/userInterfaces/*": ["./features/user/interfaces/*"],
      "@/userHelpers/*": ["./features/user/helpers/*"],
      //seller
      "@/sellerComponents/*": ["./features/seller/components/*"],
      "@/sellerContexts/*": ["./features/seller/contexts/*"],
      "@/sellerHooks/*": ["./features/seller/hooks/*"],
      "@/sellerServices/*": ["./features/seller/services/*"],
      "@/sellerPages/*": ["./features/seller/pages/*"],
      "@/sellerRedux/*": ["./features/seller/redux/*"],
      "@/sellerInterfaces/*": ["./features/seller/interfaces/*"],
      "@/sellerHelpers/*": ["./features/seller/helpers/*"],
      "@/sellerForms/*": ["./features/seller/components/forms/*"],
      //product
      "@/productComponents/*": ["./features/product/components/*"],
      "@/productContexts/*": ["./features/product/contexts/*"],
      "@/productHooks/*": ["./features/product/hooks/*"],
      "@/productServices/*": ["./features/product/services/*"],
      "@/productPages/*": ["./features/product/pages/*"],
      "@/productRedux/*": ["./features/product/redux/*"],
      "@/productInterfaces/*": ["./features/product/interfaces/*"],
      "@/productHelpers/*": ["./features/product/helpers/*"],
      "@/productForms/*": ["./features/product/components/forms/*"],
      //customer
      "@/customerComponents/*": ["./features/customer/components/*"],
      "@/customerContexts/*": ["./features/customer/contexts/*"],
      "@/customerHooks/*": ["./features/customer/hooks/*"],
      "@/customerServices/*": ["./features/customer/services/*"],
      "@/customerPages/*": ["./features/customer/pages/*"],
      "@/customerRedux/*": ["./features/customer/redux/*"],
      "@/customerInterfaces/*": ["./features/customer/interfaces/*"],
      "@/customerHelpers/*": ["./features/customer/helpers/*"],
      //cart
      "@/cartComponents/*": ["./features/cart/components/*"],
      "@/cartContexts/*": ["./features/cart/contexts/*"],
      "@/cartHooks/*": ["./features/cart/hooks/*"],
      "@/cartServices/*": ["./features/cart/services/*"],
      "@/cartPages/*": ["./features/cart/pages/*"],
      "@/cartRedux/*": ["./features/cart/redux/*"],
      "@/cartInterfaces/*": ["./features/cart/interfaces/*"],
      "@/cartHelpers/*": ["./features/cart/helpers/*"],
      //common
      "@/commonComponents/*": ["./features/common/components/*"],
      "@/commonContexts/*": ["./features/common/contexts/*"],
      "@/commonHooks/*": ["./features/common/hooks/*"],
      "@/commonServices/*": ["./features/common/services/*"],
      "@/commonPages/*": ["./features/common/pages/*"],
      "@/commonRedux/*": ["./features/common/redux/*"],
      "@/commonInterfaces/*": ["./features/common/interfaces/*"],
      "@/commonHelpers/*": ["./features/common/helpers/*"],
      //shared
      "@/sharedComponents/*": ["./features/shared/components/*"],
      "@/sharedContexts/*": ["./features/shared/contexts/*"],
      "@/sharedHooks/*": ["./features/shared/hooks/*"],
      "@/sharedServices/*": ["./features/shared/services/*"],
      "@/sharedPages/*": ["./features/shared/pages/*"],
      "@/sharedRedux/*": ["./features/shared/redux/*"],
      "@/sharedInterfaces/*": ["./features/shared/interfaces/*"],
      "@/sharedHelpers/*": ["./features/shared/helpers/*"],
      //store
      "@/storeComponents/*": ["./features/store/components/*"],
      "@/storeContexts/*": ["./features/store/contexts/*"],
      "@/storeHooks/*": ["./features/store/hooks/*"],
      "@/storeServices/*": ["./features/store/services/*"],
      "@/storePages/*": ["./features/store/pages/*"],
      "@/storeRedux/*": ["./features/store/redux/*"],
      "@/storeInterfaces/*": ["./features/store/interfaces/*"],
      "@/storeHelpers/*": ["./features/store/helpers/*"],
      //order
      "@/orderHelpers/*": ["./features/order/helpers/*"],
      "@/orderComponents/*": ["./features/order/components/*"],
      "@/orderContexts/*": ["./features/order/contexts/*"],
      "@/orderHooks/*": ["./features/order/hooks/*"],
      "@/orderServices/*": ["./features/order/services/*"],
      "@/orderPages/*": ["./features/order/pages/*"],
      "@/orderRedux/*": ["./features/order/redux/*"],
      "@/orderInterfaces/*": ["./features/order/interfaces/*"],
      //checkout
      "@/checkoutHelpers/*": ["./features/checkout/helpers/*"],
      "@/checkoutComponents/*": ["./features/checkout/components/*"],
      "@/checkoutContexts/*": ["./features/checkout/contexts/*"],
      "@/checkoutHooks/*": ["./features/checkout/hooks/*"],
      "@/checkoutServices/*": ["./features/checkout/services/*"],
      "@/checkoutPages/*": ["./features/checkout/pages/*"],
      "@/checkoutRedux/*": ["./features/checkout/redux/*"],
      "@/checkoutInterfaces/*": ["./features/checkout/interfaces/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
